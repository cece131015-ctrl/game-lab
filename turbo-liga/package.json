{
  "name": "turbo-liga",
  "version": "1.0.0",
  "description": "Futbol con coches en 3D (estilo Rocket League) con bots, salas online y chat de voz",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "build:single": "vite build --config vite.single.config.js && node scripts/copy-single.js",
    "build:all": "npm run build && npm run build:single"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
